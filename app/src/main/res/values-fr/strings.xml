    <!-- Changelog -->
    <string name="changelog_title">Changelog</string>
    <string-array name="changelog_entries">
        <item>v0.9.7 : Page Canaux, pour choisir une fréquence moins occupée.</item>
        <item>v0.9.6 : Liste des réseaux plus lisible, et nouveau relevé.</item>
        <item>v0.9.5 : Export CSV et liste des réseaux corrigés.</item>
        <item>v0.9 : Refactorisation majeure, ajout d\'une fenêtre de détails au clic sur un AP, stabilité, maintenabilité et traduction.</item>
        <item>v0.8 : Ajout de la balise GPS dans le CSV et intégration d\'un disclaimer.</item>
        <item>v0.7 : Ajout de la création de CSV et enrichissement des informations sur les points d\'accès.</item>
        <item>v0.6 : Ajout de la fonctionnalité d\'auto-connexion. Corrections de bugs.</item>
        <item>v0.5 : Interface initiale. Premières modifications.</item>
    </string-array>

