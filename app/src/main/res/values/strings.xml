    <!-- Changelog -->
    <string name="changelog_title">Changelog</string>
    <string-array name="changelog_entries">
        <item>v0.9.8 : Readable channel image, links to the code and Discord.</item>
        <item>v0.9.7 : Channels page, to pick a quieter frequency.</item>
        <item>v0.9.6 : Clearer network list, and a fresh survey.</item>
        <item>v0.9.5 : CSV export and network list fixes.</item>
        <item>v0.9 : Major code refactoring, added details dialog on AP click, stability, maintainability and translation.</item>
        <item>v0.8 : Added GPS tag in CSV and disclaimer.</item>
        <item>v0.7 : Added CSV creation and enriched access point information.</item>
        <item>v0.6 : Added auto-connect feature.</item>
        <item>v0.5 : Initial interface.</item>
    </string-array>

